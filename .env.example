# Copy this file to .env and replace placeholders locally. Never commit real values.
# VITE_* values are embedded in the browser bundle and must not contain secrets.

# Frontend and local Vite routing
VITE_APP_BASE_URL=https://example.invalid
VITE_APP_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:3001
VITE_HELIUS_PROXY_URL=/api
VITE_LOCAL_API_TARGET=http://127.0.0.1:3001
VITE_LOCAL_RPC_TARGET=http://127.0.0.1:3002
VITE_APP_VERSION=0.0.0-local
VITE_DEV_WALLET=replace-with-public-wallet-address

# Public mint and metadata configuration
VITE_METADATA_BASE_URL=https://example.invalid
VITE_METADATA_IMAGE_URL=https://example.invalid/assets/identity-prism.png
VITE_COLLECTION_MINT=replace-with-public-collection-address
VITE_UPDATE_AUTHORITY=replace-with-public-authority-address
VITE_COLLECTION_VERIFY_URL=https://example.invalid
VITE_CNFT_MINT_URL=https://example.invalid
VITE_TAPESTRY_API_KEY=replace-with-browser-client-key

# Browser observability (public client configuration)
VITE_SENTRY_DSN=
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=example.invalid
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id

# Backend listener and public origins
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
RPC_PROXY_PORT=3002
PUBLIC_BASE_URL=http://127.0.0.1:3001
CORS_ORIGIN=http://127.0.0.1:5173
RELEASE=local
ENV_PATH=./.env

# Backend providers; keep these server-side
HELIUS_API_KEY=replace-with-helius-api-key
HELIUS_API_KEYS=replace-with-helius-api-key
HELIUS_RPC_BASE=https://example.invalid
ALCHEMY_RPC_URL=https://example.invalid
FALLBACK_RPC_URL=https://example.invalid
MAGICBLOCK_RPC=https://example.invalid
JUPITER_API_KEY=replace-with-jupiter-api-key
BIRDEYE_API_KEY=replace-with-birdeye-api-key
REPUTATION_API_KEYS=replace-with-reputation-api-key
SENTRY_DSN=

# Backend authentication and signing; generate unique values per deployment
ADMIN_KEY=replace-with-long-random-admin-key
JWT_SECRET=replace-with-long-random-jwt-secret
JWT_SECRET_FILE=
JWT_TTL=1h
RPC_PROXY_TOKEN=replace-with-long-random-proxy-token
FIREBASE_SERVICE_ACCOUNT=
COLLECTION_AUTHORITY_SECRET=
CNFT_TREE_AUTHORITY_SECRET=
TREASURY_SECRET=
TREASURY_SECRET_PATH=

# Public on-chain configuration
TREASURY_ADDRESS=replace-with-public-treasury-address
CORE_COLLECTION=replace-with-public-collection-address
CNFT_MERKLE_TREE=replace-with-public-merkle-tree-address
MINT_EXTRA_PROGRAM_ALLOWLIST=
MINT_PRICE_SOL=0.01
SKR_MINT=replace-with-public-token-address
SKR_DISCOUNT=0

# Local runtime state (these paths are ignored by Git)
APP_DB_PATH=./server/data/app.db
PAYMENT_DB_PATH=./server/data/payments.db
RATE_LIMIT_DB_PATH=./server/data/ratelimit.db
COINS_STORE_FILE=./server/data/coins.json
GAME_SESSION_STORE_FILE=./server/data/game-sessions.json
LEADERBOARD_STORE_FILE=./server/data/leaderboard-runtime.json
SECURITY_EVENT_STORE_FILE=./server/data/security-events.json
SYBIL_GRAPH_FILE=./server/data/sybil-graph-runtime.json
METADATA_DIR=./metadata

# Optional backend controls
GAME_SESSION_REQUIRE_TOKEN=true
GAME_SESSION_TTL_MS=3600000
GAME_START_TOKEN_TTL_MS=300000
MAX_SIGNATURE_PAGES=10
ENABLE_COMPOSITE_BACKFILL=false
ENABLE_SYBIL_BACKFILL=false
SYBIL_BACKFILL_DELAY_MS=1000
SYBIL_BACKFILL_MAX=100
BRACKETS_DEPLOY_TS=0

# Local preview and generated-media scripts
PREVIEW_BASE_URL=http://127.0.0.1:4173
DEMO_OUTPUT=./generated-media/demo.webm
DEMO_DURATION_MS=60000
DEMO_SCROLL_DELAY_MS=1000
DEMO_SCROLL_DISTANCE=700
DEMO_SCROLL_STEPS=8
